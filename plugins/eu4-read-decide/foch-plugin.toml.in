schema = 1

[plugin]
id = "dev.foch.read-decide"
name = "EU4 Read-Only Territory Decide"
version = "0.0.1"
license = "AGPL-3.0-only"
description = "Opt-in read-only GNN territory suggestions. The monthly probe never writes game memory."

[target]
platform = "windows-x86_64"
game = "eu4"
game_versions = "=1.37.5"
abi_major = 0

[entry]
kind = "native"
path = "plugins/foch_plugin_read_decide.dll"
phase = "entry"

[[files]]
path = "plugins/foch_plugin_read_decide.dll"
sha256 = "@DLL_SHA256@"

[lifecycle]
restart_required = true

[config.probe]
type = "bool"
default = false
description = "Install the read-only monthly suggestion probe."

[config.graph]
type = "string"
default = ""
description = "Optional prebuilt province-graph JSON. Ignored when playset is set."

[config.playset]
type = "string"
default = ""
description = "Comma-separated playset roots, game first. Each descriptor.mod replace_path is honored."

[config.weights]
type = "string"
default = ""
description = "GeneralGnn weight JSON. Trained weights stay out of the package."

[config.our_tag]
type = "string"
default = ""
description = "Three-letter tag the probe plays as."

[config.our_index]
type = "int"
default = 0
min = 0
max = 32767
description = "Country index. Overhaul mods may exceed 1024; the packed identity is an i16."

[config.enemy_index]
type = "int"
default = -1
min = -1
max = 32767
description = "Enemy country index, or -1 when no war is selected."
