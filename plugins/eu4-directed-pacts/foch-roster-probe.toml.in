schema = 1

[plugin]
id = "dev.foch.directed-pacts.roster-probe"
name = "EU4 War Roster Read Diagnostic"
version = "0.0.1"
license = "AGPL-3.0-only"
description = "Explicit read-only diagnostic; does not activate pact gameplay or enter wars."

[target]
platform = "windows-x86_64"
game = "eu4"
game_versions = "=1.37.5"
abi_major = 0

[entry]
kind = "native"
path = "plugins/eu4_directed_pacts_roster_probe.dll"
phase = "entry"

[[files]]
path = "plugins/eu4_directed_pacts_roster_probe.dll"
sha256 = "@DLL_SHA256@"

[lifecycle]
restart_required = true

[config.read_only_roster_probe]
type = "bool"
default = false
description = "Explicit read diagnostic; never enables pact gameplay or war entry."

[config.probe_case]
type = "string"
default = "roster"

[config.probe_request]
type = "string"
default = "1"

[config.probe_wars]
type = "string"
default = "HAB:FRA,ENG:FRA"

[config.probe_country_flag]
type = "string"
default = ""
description = "Optional COUNTRY:FLAG observation from one requested war principal; never consumes flags."
