schema = 1

[plugin]
id = "dev.foch.directed-pacts"
name = "EU4 Directed Pacts (native bridge unavailable)"
version = "0.0.1"
license = "AGPL-3.0-only"
description = "Directed pact policy and native integration fixtures; this build refuses game activation."

[target]
platform = "windows-x86_64"
game = "eu4"
game_versions = "=1.37.5"
abi_major = 0

[entry]
kind = "native"
path = "plugins/eu4_directed_pacts.dll"
phase = "entry"

[[files]]
path = "plugins/eu4_directed_pacts.dll"
sha256 = "@DLL_SHA256@"

[lifecycle]
restart_required = true
