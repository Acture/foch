# CWT schema fixtures must stay LF so tree-sitter byte-spans match the
# committed baselines on Windows runners (which default to core.autocrlf=true).
# NOTE: *.txt mod fixtures are intentionally NOT normalized — Paradox mod data
# is frequently CRLF and several tests exercise that, so it must stay as-is.
*.cwt text eol=lf

# Fixed merge-quality cohort fixtures are byte-addressed and rendered with LF.
src/apps/foch-cli/tests/merge_quality/fixtures/*.json text eol=lf

# Dataset records are byte-frozen; checkout conversion must not change hashes.
src/apps/foch-cli/tests/merge_quality/data/*.jsonl text eol=lf

# Vendored WinGet schemas are pinned by SHA-256; checkout must not convert them.
src/tools/foch-dev/foch_dev/schemas/** -text

# Generated by cargo-about with upstream license texts (some CRLF); the CI drift
# check compares bytes, so checkout must not convert it.
THIRD-PARTY-LICENSES.txt -text
