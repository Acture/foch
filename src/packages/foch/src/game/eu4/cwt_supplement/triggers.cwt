# foch's additions to the vendored CWTools EU4 rules, compiled after them.

# common/on_actions/00_on_actions.txt on_battle_won_unit (line 576) is a unit
# callback. Its limit calls general_with_name at lines 587, 601 and 654.
# The vendored trigger allows country only. The file's own comment at line
# 581 calls the neighbouring check a unit-scope trigger.
## scope = unit
alias[trigger:general_with_name] = scalar

# The same unit callback's limit names mercenary_company at lines 771 and 772
# (merc_black_army, merc_black_army_2). The vendored trigger allows country only.
## scope = unit
alias[trigger:mercenary_company] = <mercenary_company>
